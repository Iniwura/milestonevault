  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-react": "^5.0.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
